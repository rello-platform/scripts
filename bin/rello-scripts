#!/usr/bin/env node
// Canonical CLI for @rello-platform/scripts.
// Routes subcommands to bundled bash scripts under scripts/.
//
// Subcommands:
//   floating-refs           — gate: rejects floating/non-canonical @rello-platform/* refs in package.json
//   roles                   — gate: rejects hardcoded lead-facing role labels in src/
//   db-apply-sql            — operational: applies prisma/sql/*.sql files via prisma db execute
//   pre-delete-grep-gate    — pre-commit gate: deletion commits cite Rule J grep evidence (warn)
//   schema-change-reminder  — pre-commit advisory: prisma/schema.prisma staged → reminder to verify
//   check-stale-pins        — pre-push gate: rejects @rello-platform/* pins >= 2 minors behind latest tag
//   check-lockfile-ssh      — gate: rejects git+ssh resolved entries in package-lock.json (--fix rewrites)
//   check-dist-fresh        — gate: committed dist/ must byte-match a fresh build of src/ (tag-consumable artifact)
//   tag-dist-gate           — pre-push hook: refuses a v* tag carrying a stale/unverifiable dist/ (branch pushes untouched)
//   check-manifest-regression — gate: a package manifest must never go backwards (version down / exports narrowed)
//   check-explicit-apikey   — counts RelloClient sites relying on the implicit RELLO_API_KEY fallback
//
// Behavior parity with the pre-cutover .sh siblings is the explicit acceptance
// criterion (PA-053 Phase 2.A). Each subcommand spawns the bundled .sh script
// in the consumer's CWD and propagates its exit status verbatim.
//
// v0.2.0 — adds --root <path> flag for floating-refs + roles subcommands.
// v0.3.0 — adds pre-delete-grep-gate + schema-change-reminder pre-commit hooks
//          per SPEC-PLATFORM-LINT-RULES-AND-HOOKS Phase 1 PR-C.
// v0.4.0 — adds check-stale-pins (version-staleness gate, tags-not-releases)
//          per PLATFORM-PACKAGE-PIN-CONVENTION-AND-VERSION-SYNC Phase 4 (FIX-11).
// v0.6.0 — adds verify-sql-objects: asserts every object declared in
//          prisma/sql/*.sql actually exists in the live database. `prisma db
//          push` silently DROPS every object Prisma's DSL cannot model
//          (predicated indexes, hnsw/gin/gist, triggers, functions, CHECK
//          constraints, cross-schema views, enum members), and `migrate diff`
//          is structurally blind to the whole class — the drift signal
//          disappears at the moment the damage is done. Only a catalog query
//          can see it. Ships here rather than as 13 copies of a 900-line
//          parser: this package already owns db-apply-sql, the counterpart
//          operation.
// v0.5.0 — adds check-lockfile-ssh (Railway-unfetchable git+ssh lockfile guard,
//          also run by check-stale-pins so consumers inherit it pin-bump-only)
//          per DISCOVERED-PLATFORM-GITHUB-PIN-SSH-LOCKFILE-RAILWAY-CACHE-LUCK-260610.
// v0.7.0 — adds check-dist-fresh: asserts a package's COMMITTED dist/ is
//          byte-identical to a fresh build of its own src/. The platform
//          installs from GIT TAGS, so the artifact a consumer receives is
//          whatever dist/ was committed at that tag — and nothing verified that
//          the committed output came from the committed input. A tag can carry
//          src/ from one commit and dist/ from an older one, and every consumer
//          installs the stale output with no signal at install, build or
//          runtime (the consumer's tsc typechecks fine, because the stale
//          .d.ts is that artifact's own honest self-description).
//          Builds TWICE and compares the two fresh builds to each other first:
//          a non-deterministic toolchain is UNVERIFIED, never a pass and never
//          STALE. Measured 2026-09-04: tsc and tsup are both byte-stable across
//          absolute paths, so no normalisation is needed today.
// Backward-compatible: defaults preserve v0.1.0 + v0.2.0 behavior on every input.

"use strict";

const { spawnSync } = require("child_process");
const fs = require("fs");
const path = require("path");

const SUBCOMMANDS = {
  "floating-refs": "check-floating-refs.sh",
  "roles": "check-hardcoded-roles.sh",
  "db-apply-sql": "db-apply-sql.sh",
  "pre-delete-grep-gate": "pre-delete-grep-gate.sh",
  "schema-change-reminder": "schema-change-reminder.sh",
  "check-stale-pins": "check-stale-pins.sh",
  "check-lockfile-ssh": "check-lockfile-ssh.sh",
  "verify-sql-objects": "verify-sql-objects.mjs",
  "check-dist-fresh": "check-dist-fresh.mjs",
  "tag-dist-gate": "tag-dist-gate.mjs",
  "check-manifest-regression": "check-manifest-regression.mjs",
  "check-explicit-apikey": "check-explicit-apikey.mjs",
  "audit-published-tags": "audit-published-tags.mjs",
};

// Most subcommands are bash. verify-sql-objects is a Node ESM parser (it walks
// SQL with dollar-quote/string/comment awareness and queries pg catalogs), so
// it is dispatched to node. Routing is by file extension rather than a second
// list, so a future subcommand cannot be added to one table and forgotten in
// the other.
const runnerFor = (scriptName) =>
  scriptName.endsWith(".mjs") || scriptName.endsWith(".js") ? process.execPath : "bash";

// Subcommands that accept --root <path>. `db-apply-sql` uses positional args
// per PA-049's locked contract, so it is excluded.
const ROOT_AWARE = new Set([
  "audit-published-tags",
  "check-manifest-regression",
  "check-explicit-apikey",
  "floating-refs",
  "roles",
  "check-stale-pins",
  "check-lockfile-ssh",
  "check-dist-fresh",
]);

const args = process.argv.slice(2);
const subcommand = args[0];

if (!subcommand || subcommand === "--help" || subcommand === "-h") {
  process.stdout.write(
    "Usage: rello-scripts <subcommand> [args...]\n" +
    "\n" +
    "Subcommands:\n" +
    "  floating-refs [--root <dir>] [package.json]   Gate: reject floating @rello-platform/* refs\n" +
    "  roles [--root <dir>]                          Gate: reject hardcoded lead-facing role labels\n" +
    "  db-apply-sql [schema] [sql-dir]               Apply prisma/sql/*.sql via prisma db execute\n" +
    "  pre-delete-grep-gate                          Pre-commit: cite Rule J grep evidence on deletes (warn)\n" +
    "  schema-change-reminder                        Pre-commit: remind to verify when prisma/schema.prisma staged\n" +
    "  check-stale-pins [--root <dir>]               Gate: reject @rello-platform/* pins >= 2 minors behind latest tag\n" +
    "  check-lockfile-ssh [--root <dir>] [--fix]     Gate: reject git+ssh resolved entries in package-lock.json\n" +
    "  check-dist-fresh [--root <dir>] [--ref <r>]   Gate: committed dist/ must reproduce byte-identically from src/\n" +
    "  check-manifest-regression [--root <dir>]      Gate: version never decreases, exports never narrows\n" +
    "                            [--against <ref>]   (baseline = newest v* tag; absence of exports is not narrowing)\n" +
    "  check-explicit-apikey [--root <dir>]          Count RelloClient sites relying on the implicit RELLO_API_KEY\n" +
    "  tag-dist-gate                                 Pre-push hook: refuse a v* tag whose dist/ is stale/UNVERIFIED\n" +
    "                                                (reads pre-push stdin; branch pushes pass through untouched)\n" +
    "                                                (exit 1 = STALE, 2 = UNVERIFIED and never a pass)\n" +
    "  verify-sql-objects [--url <conn>]             Gate: assert every prisma/sql-declared object EXISTS in the DB\n" +
    "                     [--sql-dir <dir>]          (exit 1 = missing, 2 = UNVERIFIED and never a pass)\n" +
    "                                                (--fix rewrites github.com entries to git+https, sha preserved)\n" +
    "\n" +
    "Flags:\n" +
    "  --root <path>   floating-refs: directory containing package.json (default: .)\n" +
    "                  roles: directory to scan for source files (default: src)\n" +
    "                  check-stale-pins: directory containing package.json (default: .)\n" +
    "                  check-lockfile-ssh: directory containing package-lock.json (default: .)\n" +
    "  --fix           check-lockfile-ssh: rewrite git+ssh github.com resolved entries in place\n"
  );
  process.exit(subcommand ? 0 : 2);
}

const scriptName = SUBCOMMANDS[subcommand];
if (!scriptName) {
  process.stderr.write(`ERROR: unknown subcommand '${subcommand}'.\n`);
  process.stderr.write(`Subcommands: ${Object.keys(SUBCOMMANDS).join(", ")}\n`);
  process.exit(2);
}

// Pre-validate --root for root-aware subcommands so we can return a friendly
// error message at exit code 2 BEFORE spawning bash. The .sh scripts also
// validate (defense-in-depth), but failing fast at the CLI keeps error
// messages consistent and avoids a cryptic shell error when the directory
// is missing.
const passthrough = args.slice(1);
if (ROOT_AWARE.has(subcommand)) {
  const rootIndex = passthrough.indexOf("--root");
  if (rootIndex !== -1) {
    const rootPath = passthrough[rootIndex + 1];
    if (!rootPath || rootPath.startsWith("--")) {
      process.stderr.write("ERROR: --root requires a path argument.\n");
      process.exit(2);
    }
    const resolved = path.resolve(process.cwd(), rootPath);
    if (!fs.existsSync(resolved)) {
      process.stderr.write(`ERROR: --root path does not exist: ${rootPath}\n`);
      process.exit(2);
    }
    const stat = fs.statSync(resolved);
    if (!stat.isDirectory()) {
      process.stderr.write(`ERROR: --root path is not a directory: ${rootPath}\n`);
      process.exit(2);
    }
  }
}

const scriptPath = path.join(__dirname, "..", "scripts", scriptName);
const result = spawnSync(runnerFor(scriptName), [scriptPath, ...passthrough], {
  stdio: "inherit",
  cwd: process.cwd(),
});

if (result.error) {
  process.stderr.write(`ERROR: failed to spawn bash: ${result.error.message}\n`);
  process.exit(1);
}

process.exit(result.status === null ? 1 : result.status);
