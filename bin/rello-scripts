#!/usr/bin/env node
// Canonical CLI for @rello-platform/scripts.
// Routes subcommands to bundled bash scripts under scripts/.
//
// Subcommands:
//   floating-refs           — gate: rejects floating/non-canonical @rello-platform/* refs in package.json
//   roles                   — gate: rejects hardcoded lead-facing role labels in src/
//   db-apply-sql            — operational: applies prisma/sql/*.sql files via prisma db execute
//   pre-delete-grep-gate    — pre-commit gate: deletion commits cite Rule J grep evidence (warn)
//   schema-change-reminder  — pre-commit advisory: prisma/schema.prisma staged → reminder to verify
//
// Behavior parity with the pre-cutover .sh siblings is the explicit acceptance
// criterion (PA-053 Phase 2.A). Each subcommand spawns the bundled .sh script
// in the consumer's CWD and propagates its exit status verbatim.
//
// v0.2.0 — adds --root <path> flag for floating-refs + roles subcommands.
// v0.3.0 — adds pre-delete-grep-gate + schema-change-reminder pre-commit hooks
//          per SPEC-PLATFORM-LINT-RULES-AND-HOOKS Phase 1 PR-C.
// v0.4.0 — adds check-stale-pins (version-staleness gate, tags-not-releases)
//          per PLATFORM-PACKAGE-PIN-CONVENTION-AND-VERSION-SYNC Phase 4 (FIX-11).
// Backward-compatible: defaults preserve v0.1.0 + v0.2.0 behavior on every input.

"use strict";

const { spawnSync } = require("child_process");
const fs = require("fs");
const path = require("path");

const SUBCOMMANDS = {
  "floating-refs": "check-floating-refs.sh",
  "roles": "check-hardcoded-roles.sh",
  "db-apply-sql": "db-apply-sql.sh",
  "pre-delete-grep-gate": "pre-delete-grep-gate.sh",
  "schema-change-reminder": "schema-change-reminder.sh",
  "check-stale-pins": "check-stale-pins.sh",
};

// Subcommands that accept --root <path>. `db-apply-sql` uses positional args
// per PA-049's locked contract, so it is excluded.
const ROOT_AWARE = new Set(["floating-refs", "roles", "check-stale-pins"]);

const args = process.argv.slice(2);
const subcommand = args[0];

if (!subcommand || subcommand === "--help" || subcommand === "-h") {
  process.stdout.write(
    "Usage: rello-scripts <subcommand> [args...]\n" +
    "\n" +
    "Subcommands:\n" +
    "  floating-refs [--root <dir>] [package.json]   Gate: reject floating @rello-platform/* refs\n" +
    "  roles [--root <dir>]                          Gate: reject hardcoded lead-facing role labels\n" +
    "  db-apply-sql [schema] [sql-dir]               Apply prisma/sql/*.sql via prisma db execute\n" +
    "  pre-delete-grep-gate                          Pre-commit: cite Rule J grep evidence on deletes (warn)\n" +
    "  schema-change-reminder                        Pre-commit: remind to verify when prisma/schema.prisma staged\n" +
    "  check-stale-pins [--root <dir>]               Gate: reject @rello-platform/* pins >= 2 minors behind latest tag\n" +
    "\n" +
    "Flags:\n" +
    "  --root <path>   floating-refs: directory containing package.json (default: .)\n" +
    "                  roles: directory to scan for source files (default: src)\n" +
    "                  check-stale-pins: directory containing package.json (default: .)\n"
  );
  process.exit(subcommand ? 0 : 2);
}

const scriptName = SUBCOMMANDS[subcommand];
if (!scriptName) {
  process.stderr.write(`ERROR: unknown subcommand '${subcommand}'.\n`);
  process.stderr.write(`Subcommands: ${Object.keys(SUBCOMMANDS).join(", ")}\n`);
  process.exit(2);
}

// Pre-validate --root for root-aware subcommands so we can return a friendly
// error message at exit code 2 BEFORE spawning bash. The .sh scripts also
// validate (defense-in-depth), but failing fast at the CLI keeps error
// messages consistent and avoids a cryptic shell error when the directory
// is missing.
const passthrough = args.slice(1);
if (ROOT_AWARE.has(subcommand)) {
  const rootIndex = passthrough.indexOf("--root");
  if (rootIndex !== -1) {
    const rootPath = passthrough[rootIndex + 1];
    if (!rootPath || rootPath.startsWith("--")) {
      process.stderr.write("ERROR: --root requires a path argument.\n");
      process.exit(2);
    }
    const resolved = path.resolve(process.cwd(), rootPath);
    if (!fs.existsSync(resolved)) {
      process.stderr.write(`ERROR: --root path does not exist: ${rootPath}\n`);
      process.exit(2);
    }
    const stat = fs.statSync(resolved);
    if (!stat.isDirectory()) {
      process.stderr.write(`ERROR: --root path is not a directory: ${rootPath}\n`);
      process.exit(2);
    }
  }
}

const scriptPath = path.join(__dirname, "..", "scripts", scriptName);
const result = spawnSync("bash", [scriptPath, ...passthrough], {
  stdio: "inherit",
  cwd: process.cwd(),
});

if (result.error) {
  process.stderr.write(`ERROR: failed to spawn bash: ${result.error.message}\n`);
  process.exit(1);
}

process.exit(result.status === null ? 1 : result.status);
